{
  "title": "CI Agent Janitor",
  "uid": "agent-janitor",
  "schemaVersion": 39,
  "tags": [
    "ci",
    "capacity"
  ],
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus"
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Agents reporting",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "count(agent_janitor_last_run_timestamp_seconds)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Reclaimed (last runs)",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(agent_janitor_bytes_reclaimed{dry_run=\"false\"})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Agents < 10% free",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "count(agent_janitor_free_percent_after < 10) or vector(0)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Agents with errors",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "count(agent_janitor_errors > 0) or vector(0)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Free disk after cleanup",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "agent_janitor_free_percent_after{dry_run=\"false\"}",
          "legendFormat": "{{agent}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Bytes reclaimed per run",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "agent_janitor_bytes_reclaimed{dry_run=\"false\"}",
          "legendFormat": "{{agent}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Workspaces removed",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "agent_janitor_workspaces_removed",
          "legendFormat": "{{agent}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Run duration",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "agent_janitor_last_run_duration_seconds",
          "legendFormat": "{{agent}}",
          "refId": "A"
        }
      ]
    }
  ]
}
